{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/Custom-AI-Agent-Creation",
      "destination": "/services/custom-ai-agent-creation",
      "permanent": true
    },
    {
      "source": "/services/GEO",
      "destination": "/services/geo",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og-default.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
